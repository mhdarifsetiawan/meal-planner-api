# Database (local Docker Postgres, ganti ke Supabase connection string di production)
DATABASE_URL=postgres://postgres:postgres@localhost:5434/masakapa?sslmode=disable

# Redis (cache + rate limit)
REDIS_URL=redis://localhost:6380

# Supabase Auth (untuk verifikasi JWT dari frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# AI Provider (aktif: OpenAI, provider lain di-config lewat tabel ai_provider_config)
AI_PROVIDER_API_KEY_OPENAI=
AI_PROVIDER_API_KEY_GROQ=
AI_PROVIDER_API_KEY_GEMINI=

# Payment (Wuzzpay - belum aktif, masih pakai DummyPaymentProvider)
WUZZPAY_API_KEY=
WUZZPAY_WEBHOOK_SECRET=

# App
PORT=8080
ENV=development
